# Налаштування сервера Usty. Скопіюйте у .env (cp .env.example .env) і заповніть.
# Файл .env лежить лише на сервері й НЕ потрапляє в git.

# Адреса сайту. Домен (напр. usty.example.com) -> Caddy сам отримає HTTPS-сертифікат.
# Поки домену немає: :80 (сайт буде за http://<IP сервера>)
SITE_ADDRESS=:80

# База даних (придумайте довгий пароль; потрібен лише контейнерам)
POSTGRES_PASSWORD=

# Ключ підпису токенів входу: openssl rand -base64 48
JWT_SECRET=

# Паролі першої пари — потрібні ЛИШЕ на порожній базі (тоді створюються Бодя-адмін і Марічка).
# Якщо переносите локальну базу — паролі вже в ній, ці можна лишити порожніми.
USERS_BODYA_PASSWORD=
USERS_MARICHKA_PASSWORD=

# Telegram-бот @UstyBM_bot (токен — від @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=UstyBM_bot
# Запасний чат для пари адміна (зазвичай порожньо)
TELEGRAM_CHAT_ID=

# Автопідбір фото (https://pixabay.com/api/docs/); порожньо — працює все, крім пропозицій
PIXABAY_API_KEY=
